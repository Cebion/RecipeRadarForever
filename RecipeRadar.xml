<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

   <Script file="RegionData.lua"/>
   <Script file="RecipeData.lua"/>
   <Script file="RecipeRadar.lua"/>
   <Script file="RadarTab.lua"/>
   <Script file="RecipesTab.lua"/>
   <Script file="MainFrame.lua"/>
   <Script file="DropDowns.lua"/>

   <Frame name="RRFFrame" toplevel="true" movable="true" parent="UIParent" enableMouse="true" hidden="true">
      <Size>
         <AbsDimension x="452" y="648"/>
      </Size>
      <Anchors>
         <Anchor point="TOPLEFT">
            <Offset>
               <AbsDimension x="0" y="-104"/>
            </Offset>
         </Anchor>
      </Anchors>
      <HitRectInsets>
         <AbsInset left="0" right="34" top="0" bottom="75"/>
      </HitRectInsets>

      <Layers>
         <Layer level="BACKGROUND">
            <Texture file = "Interface\FriendsFrame\FriendsFrameScrollIcon">
               <Size>
                  <AbsDimension x="60" y="60"/>
               </Size>
               <Anchors>
                  <Anchor point="TOPLEFT">
                     <Offset>
                        <AbsDimension x="7" y="-6"/>
                     </Offset>
                  </Anchor>
               </Anchors>
            </Texture>
         </Layer>
         <Layer level="BORDER">
            <Texture file="Interface\AddOns\RecipeRadarForever\Images\Frame\FrameTopLeft">
               <Size>
                  <AbsDimension x="256" y="256"/>
               </Size>
               <Anchors>
                  <Anchor point="TOPLEFT"/>
               </Anchors>
            </Texture>
            <Texture file="Interface\AddOns\RecipeRadarForever\Images\Frame\FrameTopRight">
               <Size>
                  <AbsDimension x="256" y="256"/>
               </Size>
               <Anchors>
                  <Anchor point="TOPRIGHT"/>
               </Anchors>
            </Texture>
            <Texture name="RRFFrameBottomLeft" file="Interface\AddOns\RecipeRadarForever\Images\Frame\FrameBottomLeft">
               <Size>
                  <AbsDimension x="256" y="512"/>
               </Size>
               <Anchors>
                  <Anchor point="BOTTOMLEFT"/>
               </Anchors>
            </Texture>
            <Texture name="RRFFrameBottomRight" file="Interface\AddOns\RecipeRadarForever\Images\Frame\FrameBottomRight">
               <Size>
                  <AbsDimension x="256" y="512"/>
               </Size>
               <Anchors>
                  <Anchor point="BOTTOMRIGHT"/>
               </Anchors>
            </Texture>

            <FontString name="RRFTitleBarText" inherits="GameFontNormal">
               <Anchors>
                  <Anchor point="TOP" relativeTo="RRFFrame" relativePoint="TOP">
                     <Offset>
                        <AbsDimension x="-7" y="-17"/>
                     </Offset>
                  </Anchor>
               </Anchors>
            </FontString>
            <FontString inherits="GameFontNormalSmall" text="RRF_VERSION">
               <Color r="0.4" g="0.4" b="0.4"/>
               <Anchors>
                  <Anchor point="TOPRIGHT">
                     <Offset>
                        <AbsDimension x="-83" y="-19"/>
                     </Offset>
                  </Anchor>
               </Anchors>
            </FontString>

         </Layer>
         <Layer level="ARTWORK">

            <!-- Upper horizontal bar -->
            <Texture file="Interface\AddOns\RecipeRadarForever\Images\Frame\HorizontalBarLeft">
               <Size>
                  <AbsDimension x="256" y="16"/>
               </Size>
               <Anchors>
                  <Anchor point="TOPLEFT">
                     <Offset>
                        <AbsDimension x="15" y="-221"/>
                     </Offset>
                  </Anchor>
               </Anchors>
            </Texture>
            <Texture file="Interface\AddOns\RecipeRadarForever\Images\Frame\HorizontalBarRight">
               <Size>
                  <AbsDimension x="256" y="16"/>
               </Size>
               <Anchors>
                  <Anchor point="TOPRIGHT">
                     <Offset>
                        <AbsDimension x="-39" y="-221"/>
                     </Offset>
                  </Anchor>
               </Anchors>
            </Texture>

            <!-- The lower horizontal bar is down with the RRFMapFrame -->

         </Layer>
      </Layers>

      <Frames>

         <!-- This is the little X button in the top-right corner. -->
         <Button name="RRFExitButton" inherits="UIPanelCloseButton">
            <Anchors>
               <Anchor point="TOPRIGHT" relativeTo="RRFFrame" relativePoint="TOPRIGHT">
                  <Offset>
                     <AbsDimension x="-30" y="-8"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>

         <!-- This is the little lock button in the top-right corner. -->
         <Button name="RRFLockButton">
            <Size>
               <AbsDimension x="32" y="32"/>
            </Size>
            <Anchors>
               <Anchor point="RIGHT" relativeTo="RRFExitButton" relativePoint="LEFT">
                  <Offset>
                     <AbsDimension x="11" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <Scripts>
               <OnClick>
                  RRF_ToggleLock()
               </OnClick>
            </Scripts>
            <NormalTexture name="RRFLockNormal"/>
            <PushedTexture name="RRFLockPushed"/>
            <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
         </Button>

         <!-- These are the two tabs at the top of the scroll frame. -->
         <Button name="RRFRadarTabFrame" inherits="RRFTabButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT">
                  <Offset>
                     <AbsDimension x="15" y="-69"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <Scripts>
               <OnLoad>
                  self.ScrollValue = 0
                  self:SetNormalTexture(RRF_IMAGE_ROOT .. "Misc\\Radar")
                  self:GetHighlightTexture():SetTexture(RRF_IMAGE_ROOT .. "Icons\\Highlight")
                  RRFRadarTabFrameMiddle:SetPoint("TOPLEFT", RRFRadarTabFrameLeft, "TOPRIGHT", 0, 6)
               </OnLoad>
               <OnClick>
                  RRF_RadarTab_OnClick()
               </OnClick>
            </Scripts>
         </Button>
         <Button name="RRFRecipesTabFrame" inherits="RRFTabButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFRadarTabFrame" relativePoint="TOPRIGHT"/>
            </Anchors>
            <Scripts>
               <OnLoad>
                  self.ScrollValue = 0
                  self:GetHighlightTexture():SetTexture(RRF_IMAGE_ROOT .. "Icons\\Highlight")
                  RRFRecipesTabFrameLeft:SetTexture(RRF_IMAGE_ROOT .. "Frame\\Tab-Right")
                  RRFRecipesTabFrameLeft:SetPoint("TOPLEFT", RRFRadarTabFrameRight, "TOPRIGHT")
               </OnLoad>
               <OnClick>
                  RRF_RecipesTab_OnClick()
               </OnClick>
            </Scripts>
         </Button>

         <!-- Filter dropdowns (Menu API). Set up in DropDowns.lua. -->
         <DropdownButton name="RRF_PersonAvailDropDown" inherits="WowStyle1DropdownTemplate" hidden="true">
            <Size x="150" y="22"/>
            <Anchors>
               <Anchor point="TOPRIGHT" relativeTo="RRFFrame" relativePoint="TOPRIGHT" x="-46" y="-42"/>
            </Anchors>
         </DropdownButton>
         <DropdownButton name="RRF_RealmAvailDropDown" inherits="WowStyle1DropdownTemplate" hidden="true">
            <Size x="150" y="22"/>
            <Anchors>
               <Anchor point="TOPRIGHT" relativeTo="RRF_PersonAvailDropDown" relativePoint="TOPRIGHT"/>
            </Anchors>
         </DropdownButton>
         <DropdownButton name="RRF_Prof1DropDown" inherits="WowStyle1DropdownTemplate">
            <Size x="150" y="22"/>
            <Anchors>
               <Anchor point="TOPRIGHT" relativeTo="RRF_PersonAvailDropDown" relativePoint="BOTTOMRIGHT" x="0" y="-3"/>
            </Anchors>
         </DropdownButton>
         <DropdownButton name="RRF_Prof2DropDown" inherits="WowStyle1DropdownTemplate">
            <Size x="150" y="22"/>
            <Anchors>
               <Anchor point="TOPRIGHT" relativeTo="RRF_PersonAvailDropDown" relativePoint="BOTTOMRIGHT" x="0" y="-3"/>
            </Anchors>
         </DropdownButton>
         <DropdownButton name="RRF_TeamDropDown" inherits="WowStyle1DropdownTemplate">
            <Size x="120" y="22"/>
            <Anchors>
               <Anchor point="TOPRIGHT" relativeTo="RRF_Prof1DropDown" relativePoint="TOPLEFT" x="-6" y="0"/>
            </Anchors>
         </DropdownButton>

         <!-- Contains the collapsable list of vendors and recipes -->
         <ScrollFrame name="RRFListScrollFrame" inherits="RRFListScrollFrameTemplate">
            <Size>
               <AbsDimension x="365" y="130"/>
            </Size>
            <Anchors>
               <Anchor point="TOPRIGHT" relativeTo="RRFFrame" relativePoint="TOPRIGHT">
                  <Offset>
                     <AbsDimension x="-67" y="-96"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <Layers>
               <Layer level="BACKGROUND">
                  <FontString name="RRFVendorNameDummyText" inherits="GameFontNormal" hidden="true">
                     <Size>
                        <AbsDimension x="0" y="16"/>
                     </Size>
                  </FontString>
                  <FontString name="RRFVendorNameDummySubText" inherits="GameFontNormalSmall" hidden="true">
                     <Size>
                        <AbsDimension x="0" y="16"/>
                     </Size>
                  </FontString>
               </Layer>
            </Layers>
            <Scripts>
               <OnVerticalScroll>
                  RRFAvailabilityTooltip:Hide()
                  FauxScrollFrame_OnVerticalScroll(self, offset, RRF_VENDOR_HEIGHT, RRF_FrameUpdate)
                  if (RecipeRadarForever_Options.ActiveTab == 1) then
                     RRFRadarTabFrame.ScrollValue = self.ScrollBar:GetValue()
                  else
                     RRFRecipesTabFrame.ScrollValue = self.ScrollBar:GetValue()
                  end
               </OnVerticalScroll>
            </Scripts>
         </ScrollFrame>

         <!-- Radio button indicating a mapped vendor -->
         <Frame name="RRFMapVendorIndicatorFrame" enableMouse="true">
            <Size>
               <AbsDimension x="20" y="20"/>
            </Size>
            <Anchors>
               <Anchor point="TOPLEFT">
                  <Offset>
                     <AbsDimension x="75" y="-40"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <HitRectInsets>
               <AbsInset left="0" right="-80" top="0" bottom="0"/>
            </HitRectInsets>
            <Layers>
               <Layer level="BACKGROUND">
                  <FontString name="RRFMapVendorIndicatorText" inherits="GameFontHighlightSmall">
                     <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT">
                           <Offset>
                              <AbsDimension x="0" y="0"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </FontString>
                  <Texture file="Interface\Buttons\UI-RadioButton">
                     <TexCoords left="0" right="0.25" top="0" bottom="1"/>
                  </Texture>
                  <Texture name="RRFMapVendorIndicator" file="Interface\Buttons\UI-RadioButton">
                     <TexCoords left="0.25" right="0.5" top="0" bottom="1"/>
                  </Texture>
               </Layer>
            </Layers>
            <Scripts>
               <OnLoad>
                  RRFMapVendorIndicator:SetVertexColor(1.0, 0, 0)
               </OnLoad>
               <OnEnter>
                  GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                  GameTooltip:SetText(RRF_S("Shift-click a vendor to add or remove her location on the world map."), nil, nil, nil, nil, true)
               </OnEnter>
               <OnLeave>
                  GameTooltip:Hide()
               </OnLeave>
            </Scripts>
         </Frame>

         <Button name="RRFVendor1" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFFrame">
                  <Offset>
                     <AbsDimension x="22" y="-96"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor2" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor1" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor3" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor2" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor4" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor3" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor5" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor4" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor6" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor5" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor7" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor6" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor8" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor7" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>
         <Button name="RRFVendor9" inherits="RRFVendorButtonTemplate">
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFVendor8" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Button>

         <Frame name="RRFHighlightFrame" hidden="true">
            <Size>
               <AbsDimension x="452" y="16"/>
            </Size>
            <Anchors>
               <Anchor point="TOPLEFT"/>
            </Anchors>
            <Layers>
               <Layer level="ARTWORK">
                  <Texture name="RRFHighlight" file="Interface\AddOns\RecipeRadarForever\Images\Misc\RecipeHighlight"/>
               </Layer>
            </Layers>
         </Frame>

         <Frame name="RRFDetailFrame">
            <Size>
               <AbsDimension x="393" y="176"/>
            </Size>
            <Anchors>
               <Anchor point="TOPLEFT" relativeTo="RRFListScrollFrame" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="0" y="-8"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <Layers>
               <Layer level="BACKGROUND">
                  <FontString name="RRFRecipeDetailName" inherits="GameFontNormal" justifyH="LEFT">
                     <Size>
                        <AbsDimension x="393" y="0"/>
                     </Size>
                     <Anchors>
                        <Anchor point="TOPLEFT">
                           <Offset>
                              <AbsDimension x="46" y="-2"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </FontString>
                  <FontString name="RRFRecipeDetailSubText" inherits="GameFontNormal" justifyH="LEFT">
                     <Size>
                        <AbsDimension x="0" y="0"/>
                     </Size>
                     <Anchors>
                        <Anchor point="LEFT" relativeTo="RRFRecipeDetailName" relativePoint="RIGHT">
                           <Offset>
                              <AbsDimension x="5" y="0"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </FontString>
                  <FontString name="RRFRecipeDetailCostText" inherits="GameFontNormalSmall" justifyH="LEFT" text="COSTS_LABEL">
                     <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="RRFRecipeDetailName" relativePoint="BOTTOMLEFT">
                           <Offset>
                              <AbsDimension x="0" y="-4"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </FontString>
                  <FontString name="RRFRecipeDetailNoteText" inherits="GameFontNormalSmall" justifyH="LEFT" text="NOTE_COLON">
                     <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="RRFRecipeDetailCostText" relativePoint="BOTTOMLEFT">
                           <Offset>
                              <AbsDimension x="0" y="-4"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </FontString>
                  <FontString name="RRFRecipeDetailRequirements" inherits="GameFontHighlightSmall" justifyH="LEFT">
                     <Size>
                        <AbsDimension x="393" y="0"/>
                     </Size>
                     <Anchors>
                        <Anchor point="LEFT" relativeTo="RRFRecipeDetailNoteText" relativePoint="RIGHT">
                           <Offset>
                              <AbsDimension x="5" y="0"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </FontString>
               </Layer>
            </Layers>
            <Frames>
               <Button name="RRFRecipeDetailIcon">
                  <Size>
                     <AbsDimension x="37" y="37"/>
                  </Size>
                  <Anchors>
                     <Anchor point="TOPLEFT">
                        <Offset>
                           <AbsDimension x="5" y="-4"/>
                        </Offset>
                     </Anchor>
                  </Anchors>
                  <Layers>
                     <Layer level="BACKGROUND">
                        <Texture file="Interface\Buttons\UI-EmptySlot">
                           <Size>
                              <AbsDimension x="64" y="64"/>
                           </Size>
                           <Anchors>
                              <Anchor point="TOPLEFT">
                                 <Offset>
                                    <AbsDimension x="-13" y="13"/>
                                 </Offset>
                              </Anchor>
                           </Anchors>
                        </Texture>
                     </Layer>
                  </Layers>
                  <Scripts>
                     <OnClick function="RRF_RecipeDetailIcon_OnClick"/>
                     <OnEnter function="RRF_RecipeDetailIcon_OnEnter"/>
                     <OnLeave function="RRF_RecipeDetailIcon_OnLeave"/>
                  </Scripts>
               </Button>
               <Frame name="RRFRecipeDetailMoneyFrame" inherits="SmallMoneyFrameTemplate">
                  <Anchors>
                     <Anchor point="LEFT" relativeTo="RRFRecipeDetailCostText" relativePoint="RIGHT">
                        <Offset>
                           <AbsDimension x="5" y="0"/>
                        </Offset>
                     </Anchor>
                  </Anchors>
                  <Scripts>
                     <OnLoad>
                        SmallMoneyFrame_OnLoad(self)
                        MoneyFrame_SetType(self, "STATIC")
                     </OnLoad>
                  </Scripts>
               </Frame>
            </Frames>
         </Frame>

         <Frame name="RRFMapFrame">
            <Size>
               <AbsDimension x="386" y="257"/>
            </Size>
            <Anchors>
               <Anchor point="BOTTOMLEFT" relativeTo="RRFFrame" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="21" y="104"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <Layers>
               <Layer level="BACKGROUND">
                  <!-- Placeholder for showing our maps via the code -->
                  <Texture name="RRFRegionMap">
                     <Size>
                        <AbsDimension x="386" y="386"/>
                     </Size>
                     <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeTo="RRFMapFrame" relativePoint="BOTTOMLEFT">
                           <Offset>
                              <AbsDimension x="0" y="0"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </Texture>
               </Layer>

               <Layer level="OVERLAY">
                  <!-- Lower horizontal bar, all the way down here because
                       it wasn't overlaying the map otherwise! -->
                  <Texture file="Interface\AddOns\RecipeRadarForever\Images\Frame\HorizontalBarLeft">
                     <Size>
                        <AbsDimension x="256" y="16"/>
                     </Size>
                     <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="RRFFrame" relativePoint="TOPLEFT">
                           <Offset>
                              <AbsDimension x="15" y="-276"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </Texture>
                  <Texture file="Interface\AddOns\RecipeRadarForever\Images\Frame\HorizontalBarRight">
                     <Size>
                        <AbsDimension x="256" y="16"/>
                     </Size>
                     <Anchors>
                        <Anchor point="TOPRIGHT" relativeTo="RRFFrame" relativePoint="TOPRIGHT">
                           <Offset>
                              <AbsDimension x="-39" y="-276"/>
                           </Offset>
                        </Anchor>
                     </Anchors>
                  </Texture>
               </Layer>
            </Layers>
         </Frame>

         <Button name="RRFScroll1" inherits="RRFScrollTemplate"/>
         <Button name="RRFScroll2" inherits="RRFScrollTemplate"/>
         <Button name="RRFScroll3" inherits="RRFScrollTemplate"/>
         <Button name="RRFScroll4" inherits="RRFScrollTemplate"/>
         <Button name="RRFScroll5" inherits="RRFScrollTemplate"/>
         <Button name="RRFScroll6" inherits="RRFScrollTemplate"/>

         <!-- Bottom row, with money and buttons. -->
         <Frame name="RRFMoneyFrame" inherits="SmallMoneyFrameTemplate">
            <Anchors>
               <Anchor point="BOTTOMRIGHT" relativeTo="RRFFrame" relativePoint="BOTTOMLEFT">
                  <Offset>
                     <AbsDimension x="180" y="86"/>
                  </Offset>
               </Anchor>
            </Anchors>
         </Frame>

         <Button name="RRFOptionsButton" inherits="UIPanelButtonTemplate">
            <Size>
               <AbsDimension x="80" y="22"/>
            </Size>
            <Anchors>
               <Anchor point="CENTER" relativeTo="RRFFrame" relativePoint="BOTTOMRIGHT">
                  <Offset>
                     <AbsDimension x="-162" y="91"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <Scripts>
               <OnClick>
                  PlaySound(SOUNDKIT.IG_MAINMENU_OPTION)
                  RRF_OptionsFrame_Toggle()
               </OnClick>
            </Scripts>
         </Button>
         <Button name="RRFCloseButton" inherits="UIPanelButtonTemplate" text="CLOSE">
            <Size>
               <AbsDimension x="80" y="22"/>
            </Size>
            <Anchors>
               <Anchor point="CENTER" relativeTo="RRFOptionsButton" relativePoint="CENTER">
                  <Offset>
                     <AbsDimension x="80" y="0"/>
                  </Offset>
               </Anchor>
            </Anchors>
            <Scripts>
               <OnClick>
                  self:GetParent():Hide()
               </OnClick>
            </Scripts>
         </Button>

      
      
      </Frames>

      <Scripts>
         <OnLoad function="RRF_OnLoad"/>
         <OnEvent function="RRF_OnEvent"/>
         <OnShow function="RRF_OnShow"/>
         <OnHide function="RRF_OnHide"/>
         <OnDragStart>
            if (button == "LeftButton") then RRF_StartMoving() end
         </OnDragStart>
         <OnDragStop>
            RRFFrame:StopMovingOrSizing()
         </OnDragStop>
         <OnMouseUp>
            RRFFrame:StopMovingOrSizing()
         </OnMouseUp>
      </Scripts>
   </Frame>
</Ui>
